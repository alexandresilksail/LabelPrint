# CodeLabel Studio 服务端环境变量示例
# 复制为 .env 后填写真实值；切勿把真实 .env 提交到版本库。

# ---- 基础 ----
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# ---- 数据库 ----
# 开发环境可使用 SQLite：
DATABASE_URL=sqlite:///./dev.db
# 生产环境使用 PostgreSQL：
# DATABASE_URL=postgresql+psycopg2://codelabel:CHANGE_ME@db:5432/codelabel

# ---- 安全 ----
# 授权签名私钥：仅服务端保存；客户端内置公开验证密钥
LICENSE_SIGNING_PRIVATE_KEY=CHANGE_ME
LICENSE_SIGNING_PUBLIC_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- 试用与离线宽限 ----
TRIAL_DAYS=7
OFFLINE_GRACE_HOURS=72

# ---- 邮件（SMTP）----
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=no-reply@example.com
# 开发环境可设为 console / mock（仅开发用途，不得用于生产）

# ---- 支付 ----
# manual = 人工付款确认（开发阶段）；正式上线前替换为合规支付服务商
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=CHANGE_ME

# ---- 管理员初始账号（生产环境必须修改，且不得使用默认密码）----
ADMIN_INITIAL_USERNAME=CHANGE_ME
ADMIN_INITIAL_PASSWORD=CHANGE_ME
